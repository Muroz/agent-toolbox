#!/usr/bin/env bash
# Launcher/multiplexer for the branch-token-tracker CLI. Added to PATH when the
# plugin is installed, and also invoked directly by the hooks. Resolves the
# bundled scripts relative to itself, so it works in both installed and
# --plugin-dir dev modes with no CLAUDE_PLUGIN_* env var.
#
#   btt ingest --event <Hook> ...   -> ingest.py   (used by the hooks)
#   btt report [TICKET] ...         -> report.py
#   btt backfill                    -> maintenance.py (repair pass)
#
# Python resolution: a project may pin an uninstalled version via a pyenv
# `.python-version`, which makes a bare `python3` (the pyenv shim) fail before
# our code runs. The plugin's scripts are stdlib-only and run on any Python 3.9+,
# so we force pyenv's `system` interpreter (harmless when pyenv is absent).
# Override with BTT_PYTHON=/path/to/python3 if needed.
set -euo pipefail

# A hook's exit code is a control channel, not a diagnostic: on UserPromptSubmit
# an exit of 2 *blocks the user's prompt* and shows them our stderr. `ingest` is
# the only subcommand the hooks call, so once we know that is what we were asked
# for, force every exit path — missing interpreter, unreadable script, a
# hooks.json older than this build passing an event we retired — to 0. The trap
# has to be installed before anything that can fail, and rules out `exec` (an
# exec'd process carries no trap of ours).
if [ "${1:-}" = "ingest" ]; then trap 'exit 0' EXIT; fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
scripts="$here/../scripts"
export PYENV_VERSION="${PYENV_VERSION:-system}"
py="${BTT_PYTHON:-python3}"
sub="${1:-}"
shift || true
case "$sub" in
  ingest) "$py" "$scripts/ingest.py" "$@" || true; exit 0 ;;
  report) exec "$py" "$scripts/report.py" "$@" ;;
  backfill) exec "$py" "$scripts/maintenance.py" backfill "$@" ;;
  *) echo "usage: btt {ingest|report|backfill} ..." >&2; exit 2 ;;
esac
